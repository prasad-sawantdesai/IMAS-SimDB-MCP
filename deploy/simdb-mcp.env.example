# Settings for simdb-mcp. Copy to deploy/simdb-mcp.env and edit.
# All settings and their defaults: docs/configuration.md

# Required: the host name(s) users put in the MCP URL.
MCP_ALLOWED_HOSTS=simdb-mcp.iter.org,simdb-mcp.iter.org:*

# SimDB server. The defaults are for simdb.iter.org.
SIMDB_URL=https://simdb.iter.org/scenarios/api
SIMDB_AUTH_MODE=f5

# Optional: a link to the SimDB dashboard in each result.
SIMDB_DASHBOARD_URL=https://simdb.iter.org/dashboard/uuid/{uuid}

# Optional, shown with their defaults:
# SIMDB_API_VERSION=auto
# SIMDB_SESSION_TTL=1800
# SIMDB_DEFAULT_RETURN_KEYS=machine,pulse,code.name,status,description
# SIMDB_DEFAULT_LIMIT=20
# SIMDB_MAX_LIMIT=200
# SIMDB_MAX_VALUE_CHARS=300
# MCP_PORT=8000
